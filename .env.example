# Copy to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=

# --- LLM cost boundary (Phase 12A) -------------------------------------------
# Retries INSIDE the Anthropic SDK. Default 0 so app/translation/translator.py's
# own MAX_RETRIES=3 loop is the ONLY retry layer; the SDK's own default of 2
# would multiply it, making one counted request up to 9 billable calls.
NLSB_ANTHROPIC_MAX_RETRIES=0
# Per-call timeout in seconds. Default 60 (the SDK's own default is 600).
# Handlers are sync and run in a bounded thread pool, so a hung call holds a
# worker slot for its full duration.
NLSB_ANTHROPIC_TIMEOUT_SECONDS=60

# In-process cache of successful NL -> IR translations, so an identical
# strategy description doesn't pay for the model twice. A hit still passes the
# per-IP rate limiter and still re-validates its IR — the cache is a cost
# optimization, never a trust boundary.
NLSB_TRANSLATION_CACHE_ENABLED=true
# Max entries. Bounded on purpose: an unbounded map keyed on user text is a
# memory-exhaustion primitive. Oldest entry is evicted on overflow.
NLSB_TRANSLATION_CACHE_SIZE=512
