# Copy to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=

# --- LLM cost boundary (Phase 12A) -------------------------------------------
# Retries INSIDE the Anthropic SDK. Default 0 so app/translation/translator.py's
# own MAX_RETRIES=3 loop is the ONLY retry layer; the SDK's own default of 2
# would multiply it, making one counted request up to 9 billable calls.
NLSB_ANTHROPIC_MAX_RETRIES=0
# Per-call timeout in seconds. Default 60 (the SDK's own default is 600).
# Handlers are sync and run in a bounded thread pool, so a hung call holds a
# worker slot for its full duration.
NLSB_ANTHROPIC_TIMEOUT_SECONDS=60

# In-process cache of successful NL -> IR translations, so an identical
# strategy description doesn't pay for the model twice. A hit still passes the
# per-IP rate limiter and still re-validates its IR — the cache is a cost
# optimization, never a trust boundary.
NLSB_TRANSLATION_CACHE_ENABLED=true
# Max entries. Bounded on purpose: an unbounded map keyed on user text is a
# memory-exhaustion primitive. Oldest entry is evicted on overflow.
NLSB_TRANSLATION_CACHE_SIZE=512

# --- Data integrity (Phase 12B) ----------------------------------------------
# How far the realized price history may fall short of the REQUESTED range
# before the request is refused with a 422. Leading slack absorbs a start date
# landing on a weekend or holiday; trailing slack absorbs vendor lag. Short
# data is never silently clamped — the user is told and can re-ask.
NLSB_COVERAGE_TOLERANCE_DAYS_START=7
NLSB_COVERAGE_TOLERANCE_DAYS_END=7

# Per-attempt network timeout for the yfinance call, in seconds.
NLSB_YFINANCE_TIMEOUT_SECONDS=30
# Retries AFTER the first attempt, so 2 means at most 3 attempts. Transport
# failures only — a frame that failed a validation guard is never retried.
# Worst case: 3 x 30s + 1.5s backoff = 91.5s.
NLSB_YFINANCE_MAX_RETRIES=2

# In-process cache of VALIDATED price frames, keyed on
# (ticker, start, end, interval). Failures and frames that failed any guard
# are never cached. Bounded for the same reason as the translation cache.
NLSB_PRICE_CACHE_ENABLED=true
NLSB_PRICE_CACHE_SIZE=64
